{
    "compilerOptions": {
        "module": "NodeNext",
        "baseUrl": "src",
        "outDir": "dist",
        "sourceMap": true,
        "noImplicitAny": true,
        "target": "ES2020", 
        "strict": true, 
        "esModuleInterop": true, 
        "skipLibCheck": true, 
        "forceConsistentCasingInFileNames": true
}, 
    "include": ["src"], 
    "exclude": ["node_modules"]
    
}